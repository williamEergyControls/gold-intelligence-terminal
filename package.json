{
  "name": "gold-intelligence-terminal",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit -p .",
    "build": "tsc --noEmit -p . && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "db:migrate:local": "wrangler d1 migrations apply gold-terminal --local",
    "db:migrate:remote": "wrangler d1 migrations apply gold-terminal --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.145.0"
  }
}
